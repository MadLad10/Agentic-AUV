# Copy to .env and fill in. .env is gitignored.
# Groq free tier (OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=
# Optional alternatives (same OpenAI-compatible client, set provider in config/llm.yaml)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Local Ollama endpoint (v2's own auv2-ollama container from scripts/start_ollama.sh)
AUV_OLLAMA_HOST=http://127.0.0.1:11437
