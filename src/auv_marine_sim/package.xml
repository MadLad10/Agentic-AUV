<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_marine_sim</name>
  <version>0.2.0</version>
  <description>MuJoCo marine simulator for the AUV: buoyancy, drag, thrusters, noisy and failing sensors, fault injection, ground-truth referee, synthetic-data auto-labelling.</description>
  <maintainer email="yaadbari21@gmail.com">Yaad Kamrul Bari</maintainer>
  <license>MIT</license>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
