<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_onboard</name>
  <version>0.2.0</version>
  <description>Deterministic onboard software: EKF navigation, guidance and control, perception fusion, health monitoring, and the VehicleBackend for the MuJoCo sim.</description>
  <maintainer email="yaadbari21@gmail.com">Yaad Kamrul Bari</maintainer>
  <license>MIT</license>
  <exec_depend>auv_marine_sim</exec_depend>
  <exec_depend>auv_mission_planner</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
